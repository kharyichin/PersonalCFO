# Copy to .env.local and fill in.
EVEROS_API_KEY=your-everos-api-key
EVEROS_BASE_URL=https://api.evermind.ai

# "mock" = built-in demo data. "backend" = teammate's Snowflake API.
FINANCE_SOURCE=mock
BACKEND_URL=http://localhost:8000

# Leave unset to use the built-in local answer engine. Set to route every
# question to the real Cortex Agent instead. See lib/cortex.ts for the contract.
# CORTEX_URL=http://localhost:8001/ask
